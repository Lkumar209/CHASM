# Copy this to .env and fill in values. Never commit .env.

# === API keys (optional — only needed if using API backend) ===
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# === Experiment tracking ===
# Set to "mlflow", "wandb", or "local" (default: local)
CHASM_TRACKER=local
MLFLOW_TRACKING_URI=http://localhost:5000
WANDB_PROJECT=chasm
WANDB_ENTITY=your_wandb_entity

# === Model cache ===
HF_HOME=./model_cache
TRANSFORMERS_CACHE=./model_cache/transformers

# === Misc ===
CHASM_LOG_LEVEL=INFO
